# Copy to .env, edit locally, and NEVER commit .env.
# 192.0.2.0/24 is RFC 5737 documentation-only TEST-NET, not a usable home LAN.
AX73_ROUTER_URL=https://192.0.2.1
AX73_SUBNET=192.0.2.0/26
AX73_DHCP_START=192.0.2.21
AX73_DHCP_END=192.0.2.60
NETBOX_CONTAINER=netbox-docker-netbox-1
AX73_GRACE_MINUTES=60
# Defaults to current repository directory if omitted.
# AX73_BASE_DIR=/srv/ax73-netbox-sync
# AX73_PASSWORD_FILE=/srv/ax73-netbox-sync/secrets/router_password
# AX73_OUTPUT_FILE=/srv/ax73-netbox-sync/data/ax73_clients.json
# Set to 1 ONLY after backup and dry-run validation.
AX73_APPLY=0
